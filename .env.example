# Copy this file to .env and fill in your API credentials.
# .env is ignored by git.

# Meta Model API (Muse Wonder, Muse Spark, Muse Glimmer)
META_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.llama.com/v1
META_MODEL_WONDER=Llama-4-Maverick-17B-128E-Instruct-FP8
META_MODEL_SPARK=Llama-3.3-70B-Instruct
META_MODEL_GLIMMER=Llama-3.3-70B-Instruct

# Fireworks AI Inference
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Baseten GPU Inference (Muse Spark Open Hackathon Endpoint)
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional Local / Custom OpenAI-Compatible Endpoint (vLLM, Ollama, LM Studio)
LOCAL_LLM_API_KEY=
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Partner GPU compute
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# Engine runtime settings
CORTIVRA_DEVICE=auto
CORTIVRA_DEFAULT_PRECISION=float32
CORTIVRA_VAULT_PATH=./vault_showcase
