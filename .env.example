# Copy this file to .env and fill in your API credentials.
# .env is ignored by git.

# Meta Model API (Muse Spark, Muse Wonder, Muse Glimmer, SAM 3.1)
META_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.llama.com/v1

# Partner inference and GPU endpoints (Muse Spark Open)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here
BASETEN_API_KEY=your_baseten_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Engine runtime settings
CORTIVRA_DEVICE=auto
CORTIVRA_DEFAULT_PRECISION=float32
CORTIVRA_VAULT_PATH=./vault_showcase
